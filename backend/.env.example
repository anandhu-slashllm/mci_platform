# ---- Database (Supabase Postgres) ---------------------------------------------------------------
# Local CLI stack (`npx supabase start`): direct connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
# Hosted / Vercel: use the Supavisor *transaction* pooler URL (port 6543) and DB_POOL_MODE=serverless
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_MODE=pooled

# ---- Supabase (values from `npx supabase status -o env`, or Project Settings > API) -------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects signing with the legacy HS256 secret (the local CLI does). Asymmetric keys use JWKS automatically.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_STORAGE_BUCKET=mci-uploads

# Local dev only: echo the emailed OTP back to the UI by reading Mailpit. Never set in production.
OTP_DEV_MODE=true
SUPABASE_DEV_MAILBOX_URL=http://127.0.0.1:54324

# ---- App secrets ----------------------------------------------------------------------------------
# Signs attendance-QR tokens (user sessions are Supabase JWTs)
SECRET_KEY=change-me
# Encrypts NRIC / bank fields. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=15728640

# ---- Background work -----------------------------------------------------------------------------
# loop = in-process loops (uvicorn/Docker). cron = only via /internal/cron/* (Vercel Cron), needs CRON_SECRET.
BACKGROUND_MODE=loop
CRON_SECRET=
