# Frontend (Vite). The API base defaults to /api, which FastAPI also serves (same origin).
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend/ .
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# API + embedded static UI
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
COPY --from=frontend-build /app/dist ./static
COPY infra/docker-entrypoint-api.py /docker-entrypoint-api.py
ENV PYTHONPATH=/app
EXPOSE 8000
ENTRYPOINT ["python", "/docker-entrypoint-api.py"]
